<div class="nav-computer-shell" data-app-id="{{appId}}">
  <header class="nav-computer-header">
    <p class="nav-computer-kicker">{{subtitle}}</p>
    <h1 class="nav-computer-title">{{title}}</h1>
  </header>

  <section class="nav-computer-panel nav-computer-panel-main">
    <p class="nav-computer-placeholder">{{placeholderText}}</p>
  </section>

  <section class="nav-computer-panel nav-computer-status">
    <h2 class="nav-computer-section-title">{{localize "SW5ENAVCOMPUTER.App.StatusLabel"}}</h2>
    <p class="nav-computer-status-text">{{statusText}}</p>
  </section>
</div>
