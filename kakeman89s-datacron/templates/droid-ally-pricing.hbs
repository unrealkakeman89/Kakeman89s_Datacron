<div class="droid-ally-shell droid-ally-pricing" data-app-id="{{appId}}">
  <header class="datacron-header">
    <p class="datacron-kicker">{{subtitle}}</p>
    <h1 class="datacron-title">{{title}}</h1>
  </header>

  <section class="datacron-panel">
    <div class="datacron-grid">
      <div class="datacron-field">
        <label class="datacron-label" for="{{appId}}-droid-name">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.NameLabel"}}</label>
        <input
          id="{{appId}}-droid-name"
          class="datacron-input"
          type="text"
          value="{{input.droidName}}"
          data-droid-ally-field="droidName"
        />
      </div>
      <div class="datacron-field">
        <label class="datacron-label" for="{{appId}}-droid-class">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.ClassLabel"}}</label>
        <select id="{{appId}}-droid-class" class="datacron-select" data-droid-ally-field="droidClass">
          {{#each classes}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="datacron-field">
        <label class="datacron-label" for="{{appId}}-droid-level">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.LevelLabel"}}</label>
        <input
          id="{{appId}}-droid-level"
          class="datacron-input"
          type="number"
          min="0"
          step="1"
          value="{{input.companionLevel}}"
          data-droid-ally-field="companionLevel"
        />
      </div>
      <div class="datacron-field">
        <label class="datacron-label" for="{{appId}}-droid-systems">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.SystemsCostLabel"}}</label>
        <input
          id="{{appId}}-droid-systems"
          class="datacron-input"
          type="number"
          min="0"
          step="1"
          value="{{input.systemsCost}}"
          data-droid-ally-field="systemsCost"
        />
      </div>
      <div class="datacron-field">
        <label class="datacron-label" for="{{appId}}-droid-abilities">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.AbilityTotalLabel"}}</label>
        <input
          id="{{appId}}-droid-abilities"
          class="datacron-input"
          type="number"
          step="1"
          value="{{input.abilityModifierTotal}}"
          data-droid-ally-field="abilityModifierTotal"
        />
      </div>
      <div class="datacron-field">
        <label class="datacron-label" for="{{appId}}-droid-traits">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.TraitProtocolLabel"}}</label>
        <input
          id="{{appId}}-droid-traits"
          class="datacron-input"
          type="number"
          min="0"
          step="1"
          value="{{input.traitProtocolCount}}"
          data-droid-ally-field="traitProtocolCount"
        />
      </div>
      <div class="datacron-field">
        <label class="datacron-label" for="{{appId}}-droid-proficiencies">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.ProficiencyLabel"}}</label>
        <input
          id="{{appId}}-droid-proficiencies"
          class="datacron-input"
          type="number"
          min="0"
          step="1"
          value="{{input.trainedSkillToolCount}}"
          data-droid-ally-field="trainedSkillToolCount"
        />
      </div>
      <div class="datacron-field">
        <label class="datacron-label" for="{{appId}}-droid-feats">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.FeatUpgradeLabel"}}</label>
        <input
          id="{{appId}}-droid-feats"
          class="datacron-input"
          type="number"
          min="0"
          step="1"
          value="{{input.featUpgradeCount}}"
          data-droid-ally-field="featUpgradeCount"
        />
      </div>
    </div>

    <div class="datacron-actions datacron-actions-row">
      <button type="button" class="datacron-action-button" data-droid-ally-calculate>
        {{calculateLabel}}
      </button>
      <button type="button" class="datacron-action-button" data-droid-ally-reset>
        {{resetLabel}}
      </button>
      {{#if result}}
        <button type="button" class="datacron-action-button" data-droid-ally-quote>
          {{quoteLabel}}
        </button>
      {{/if}}
    </div>

    {{#if error}}
      <p class="droid-ally-pricing-error" role="alert">
        <strong>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.Error"}}:</strong>
        {{error}}
      </p>
    {{/if}}

    {{#if result}}
      <div class="datacron-droid-price-result">
        <h2 class="datacron-section-title">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.Result"}}</h2>
        <p class="droid-ally-pricing-status">
          <strong>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.Status"}}:</strong>
          {{result.status}}
        </p>
        {{#if result.warnings.length}}
          <ul class="droid-ally-pricing-warnings" role="status">
            {{#each result.warnings}}
              <li>
                <strong>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.Warning"}}:</strong>
                {{this}}
              </li>
            {{/each}}
          </ul>
        {{/if}}
        <dl class="datacron-route-result">
          <dt>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.NameLabel"}}</dt>
          <dd>{{result.droidName}}</dd>
          <dt>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.ClassLabel"}}</dt>
          <dd>{{result.droidClass}}</dd>
          <dt>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.LevelLabel"}}</dt>
          <dd>{{result.companionLevel}}</dd>
          <dt>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.Subtotal"}}</dt>
          <dd>{{result.subtotalFormatted}}</dd>
          <dt>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.Division"}}</dt>
          <dd>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.DivisionByTwo"}}</dd>
          <dt>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.Rounding"}}</dt>
          <dd>{{result.rounding}}</dd>
          <dt>{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.FinalPrice"}}</dt>
          <dd class="datacron-price-total">{{result.finalCostFormatted}}</dd>
        </dl>
        <ul class="datacron-droid-breakdown">
          {{#each result.breakdown}}
            <li><span>{{label}} ({{formula}})</span><strong>{{amountFormatted}}</strong></li>
          {{/each}}
        </ul>
        {{#if result.explanationLines.length}}
          <h3 class="datacron-subsection-title">{{localize "KAKEMAN89SDATACRON.DroidAllyPricing.Explanation"}}</h3>
          <ol class="droid-ally-pricing-explanation">
            {{#each result.explanationLines}}
              <li>{{this}}</li>
            {{/each}}
          </ol>
        {{/if}}
      </div>
    {{/if}}
  </section>
</div>
